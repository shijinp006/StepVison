# Copy to .env.local and fill in the values.

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/stepvision?retryWrites=true&w=majority

# Admin account created automatically on first start (only if it does not exist yet)
ADMIN_EMAIL=admin@stepvisionhotelsupplies.com
ADMIN_PASSWORD=change-this-password

# How long an access token is valid, in minutes. When it expires, the admin
# panel gets a new one with the refresh token, without asking to log in again.
ACCESS_TOKEN_TTL_MINUTES=15

# How long a login (refresh token + device id) stays valid, in hours.
# After this the admin has to sign in again.
SESSION_TTL_HOURS=24

# Secret used to sign login JWTs - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
